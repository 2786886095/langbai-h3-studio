{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Langbai H3 Studio",
  "version": "0.7.0",
  "identifier": "studio.langbai.h3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Langbai H3 Studio",
      "width": 1440,
      "height": 920,
      "minWidth": 960,
      "minHeight": 680,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "面向新手的 MiniMax-H3 视频生成工具",
    "category": "GraphicsAndDesign"
  }
}
